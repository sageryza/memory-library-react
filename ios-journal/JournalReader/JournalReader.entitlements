<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Shared with the JournalShare extension — its background uploads stage
       files here so they outlive the share sheet. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.sageryza.imageforge</string>
  </array>
</dict>
</plist>
